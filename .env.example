# Values stay in your shell or a local, gitignored .env. Never paste keys into source.
CIRCLEPATH_DATA_DIR=./data
CIRCLEPATH_HOST=127.0.0.1
CIRCLEPATH_PORT=7860
CIRCLEPATH_AI_PROVIDER=gemini
CIRCLEPATH_GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY_FILE=
# Alternatively: GEMINI_API_KEY
ARIZE_API_KEY_FILE=
# Alternatively: ARIZE_API_KEY
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=circlepath-rj
ARIZE_ENDPOINT=https://otlp.arize.com/v1/traces
# Optional additional local OTLP/HTTP trace destination (e.g. an OTel Collector).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
CIRCLEPATH_GRAFANA_URL=http://127.0.0.1:3300/d/circlepath/circlepath
# Google Calendar is opt-in. OAuth token files are kept in data/calendar/.
GOOGLE_OAUTH_CLIENT_FILE=
# No email is sent in demo mode. In-app reminders work without a mail account.
CIRCLEPATH_SMTP_ENABLED=false
CIRCLEPATH_SMTP_HOST=
CIRCLEPATH_SMTP_PORT=587
CIRCLEPATH_SMTP_USERNAME=
CIRCLEPATH_SMTP_PASSWORD=
CIRCLEPATH_SMTP_FROM=
