{
  "uid": "circlepath",
  "title": "CirclePath \u00b7 AI & case coordination",
  "tags": [
    "circlepath",
    "opentelemetry",
    "ai"
  ],
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "AI drafts prepared",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "circlepath-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(circlepath_ai_requests_total{outcome=\"success\"})",
          "legendFormat": "{{task}}{{provider}}{{decision}}{{stage}}{{direction}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Human approvals",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "circlepath-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(circlepath_draft_reviews_total{decision=\"approved\"})",
          "legendFormat": "{{task}}{{provider}}{{decision}}{{stage}}{{direction}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Reminders created",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "circlepath-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(circlepath_reminders_total)",
          "legendFormat": "{{task}}{{provider}}{{decision}}{{stage}}{{direction}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Overdue tasks needing attention",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "circlepath-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "circlepath_overdue_tasks",
          "legendFormat": "{{task}}{{provider}}{{decision}}{{stage}}{{direction}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "AI response time \u00b7 p95",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "circlepath-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(circlepath_ai_latency_seconds_bucket[5m])))",
          "legendFormat": "{{task}}{{provider}}{{decision}}{{stage}}{{direction}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Token use by direction",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "circlepath-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (circlepath_ai_tokens_total)",
          "legendFormat": "{{task}}{{provider}}{{decision}}{{stage}}{{direction}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Cases by stage",
      "type": "bargauge",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "circlepath-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "circlepath_cases",
          "legendFormat": "{{task}}{{provider}}{{decision}}{{stage}}{{direction}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Workflow operations by outcome",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "circlepath-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(circlepath_operations_total[5m]))",
          "legendFormat": "{{task}}{{provider}}{{decision}}{{stage}}{{direction}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "AI errors",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "circlepath-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task) (circlepath_ai_requests_total{outcome=\"error\"})",
          "legendFormat": "{{task}}{{provider}}{{decision}}{{stage}}{{direction}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "CirclePath agent and workflow traces",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "tempo",
        "uid": "circlepath-tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"circlepath\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
  "links": [
    {
      "title": "CirclePath local demo",
      "url": "http://127.0.0.1:7860",
      "type": "link"
    }
  ]
}
